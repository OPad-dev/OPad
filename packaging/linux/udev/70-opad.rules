# 70-opad.rules
# Espressif ESP32-S3 OPad (application firmware PID 0x4001, ROM bootloader PID 0x1001)
#
# Must sort before 73-seat-late.rules: that is where systemd turns the uaccess
# tag into an ACL for the logged-in user. A rule numbered after it tags the
# device too late and the user gets no access.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="4001|1001", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="4001|1001", TAG+="uaccess"
