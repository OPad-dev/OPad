		(path "/74b88d12-bbcb-589b-a5fc-e0c234d65c6f")
		(sheetfile "he_input_v1.kicad_sch")
		(descr "MX magnetic switch position for Hall Effect keypads (Gateron KS-20, Magnetic Jade, Wooting Lekker, Geon Raw HE), plate mounted 5.0 mm above the PCB. Two 1.75 mm side alignment peg holes only: unlike SW_MX_Hall_PlateMount there is NO 4.0 mm centre hole, because the linear Hall sensor is mounted on the bottom copper exactly at the key centre and needs solid FR-4 under the stem magnet. Keep both copper layers clear over the centre so the magnetic flux is not damped by eddy currents.")
		(tags "MX Hall Effect magnetic keyswitch plate mount rapid trigger")
