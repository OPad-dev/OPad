	(text "P2 header (GPIO names): 1 3V3, 2 GND, 3 GPIO43 TXD, 4 GPIO44 RXD, 5 GPIO47, 6 GPIO48, 7 GPIO15, 8 GPIO13, 9 GPIO11, 10 GPIO12, 11 GPIO14, 12 GPIO9, 13 GND, 14 VBAT" (exclude_from_sim no) (at 20.32 163.83 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "1cb63e37-7818-45b8-a8a4-8f7ff8fc239e"))
	(text "Module connector: 1 3V3 | 2 GND | 3 IN1 = GPIO10 | 4 IN2 = GPIO7 | 5 ID = GPIO8 | 6 GPIO6 | 7 GPIO4 | 8 GPIO2" (exclude_from_sim no) (at 20.32 167.64 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4d645dc2-3db6-41cd-80d9-ebcdbcdcbb73"))
