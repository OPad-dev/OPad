	(text "Module connector (V1 pinout): 1 3V3 | 2 GND | 3 CS = GPIO10 | 4 spare = GPIO7 | 5 ID = GPIO8 | 6 MISO = GPIO6 | 7 MOSI = GPIO4 | 8 SCLK = GPIO2" (exclude_from_sim no) (at 20.32 250.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8800375a-1ce6-4971-b2f7-860dfde107dc"))
	(text "ID = 3V3 x 100k/(100k+100k) = 1.65 V: the 'Hall SPI' module ID reserved in V1/README.md." (exclude_from_sim no) (at 20.32 253.81 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c6dc30bd-2f6d-4e2d-aa04-efd71ab1900a"))
	(text "Ratiometric: the ADS7038 reference is AVDD, the same filtered rail that powers the three sensors." (exclude_from_sim no) (at 20.32 257.62 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e60efb15-d7d3-4d4f-be10-1374036105c1"))
	(text "Key channels: key 1 = AIN5, key 2 = AIN4, key 3 = AIN3." (exclude_from_sim no) (at 20.32 261.43 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7119def7-2c89-4f7c-93b3-80fd5e6daf16"))
