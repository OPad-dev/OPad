{
  "mcpServers": {
    "flashprobe": {
      "type": "stdio",
      "command": ".tools/bin/flashprobe-mcp",
      "args": [],
      "env": {}
    },
    "espressif-docs": {
      "type": "http",
      "url": "https://mcp.espressif.com/docs"
    },
    "esp-components": {
      "type": "http",
      "url": "https://components.espressif.com/mcp"
    },
    "kicad": {
      "type": "stdio",
      "command": "node",
      "args": [
        ".tools/KiCAD-MCP-Server/dist/index.js"
      ],
      "env": {
        "LOG_LEVEL": "info",
        "KICAD_AUTO_LAUNCH": "false",
        "KICAD_PYTHON": ".tools/KiCAD-MCP-Server/.venv/bin/python"
      }
    }
  }
}
