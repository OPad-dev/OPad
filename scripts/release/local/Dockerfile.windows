# Cross-compiles the Windows binaries on Linux with cargo-xwin, for
# make release-local (docs/specs/release-and-updates.md §11). cargo-xwin
# downloads the Microsoft CRT and Windows SDK on first use, which means
# accepting Microsoft's licence for them (it is passed below on the build's
# command line, not here). The installer itself is built by the
# amake/innosetup image (Inno Setup under Wine).

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
        clang lld llvm curl ca-certificates git python3 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
        --target x86_64-pc-windows-msvc \
    && cargo install --locked cargo-xwin \
    && chmod -R a+rwX /opt/cargo /opt/rustup
