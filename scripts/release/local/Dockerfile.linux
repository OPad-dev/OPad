# The build environment of release-app.yml's Linux job, for make release-local
# (docs/specs/release-and-updates.md §11). Ubuntu 22.04 like the runner; the
# binaries target glibc 2.31 through cargo-zigbuild, tosu glibc 2.28.
#
# make tosu and test_packages.sh start containers of their own, so the
# Docker CLI is installed here and release_local.sh passes the host's socket
# in, with the repository mounted at the same path as on the host.

FROM ubuntu:22.04

ARG ZIG_VERSION=0.13.0
ARG NODE_MAJOR=24
ARG APPIMAGETOOL_VERSION=1.9.1
ARG APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0

ENV DEBIAN_FRONTEND=noninteractive \
    APPIMAGE_EXTRACT_AND_RUN=1 \
    CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:/opt/zig:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config libasound2-dev libudev-dev libx11-dev \
        libxkbcommon-dev libwayland-dev libfontconfig1-dev libdbus-1-dev \
        binutils rpm cpio file unzip curl ca-certificates git xz-utils \
        python3 docker.io jq \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && cargo install --locked cargo-deb cargo-generate-rpm cargo-zigbuild \
    && cargo install --locked cargo-about --features cli \
    && chmod -R a+rwX /opt/cargo /opt/rustup

RUN curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-x86_64-${ZIG_VERSION}.tar.xz" \
        | tar -xJ -C /opt \
    && mv "/opt/zig-linux-x86_64-${ZIG_VERSION}" /opt/zig

RUN curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g pnpm@9 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /usr/local/bin/appimagetool \
        "https://github.com/AppImage/appimagetool/releases/download/${APPIMAGETOOL_VERSION}/appimagetool-x86_64.AppImage" \
    && echo "${APPIMAGETOOL_SHA256}  /usr/local/bin/appimagetool" | sha256sum -c - \
    && chmod +x /usr/local/bin/appimagetool
